# Sel utilisé pour hasher les bonnes réponses.
# Doit être identique en dev et en prod (sinon les hash ne correspondent plus).
# Génération : openssl rand -hex 16
VITE_PUZZLE_SALT=foxtus-dev-salt

# Topic ntfy.sh pour recevoir les notifs d'avancement.
# Choisir un nom obscur (le topic est public sur ntfy.sh).
# Exemple : VITE_NTFY_TOPIC=foxtus-tonpseudo-7b3a91xx
# Laisser vide pour désactiver les notifs.
VITE_NTFY_TOPIC=
